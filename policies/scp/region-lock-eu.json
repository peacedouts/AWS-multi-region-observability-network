{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllOutsideEUJurisdictionRegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*", "organizations:*", "sts:*", "support:*", "account:*",
        "route53:*", "route53domains:*", "cloudfront:*", "waf:*", "wafv2:*",
        "globalaccelerator:*", "health:*", "trustedadvisor:*", "budgets:*", "ce:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": ["eu-central-1", "eu-west-1"]
        }
      }
    }
  ]
}
